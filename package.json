{
  "name": "hoi",
  "private": true,
  "description": "hoi.sh: a forum with nobody in the middle. Website, web app, desktop companion and mobile preparation.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "release:version": "node scripts/release-version.mjs",
    "check:quick": "node scripts/check-quick.mjs",
    "public:check": "node scripts/export-public.mjs --check",
    "public:export": "node scripts/export-public.mjs --export",
    "sandbox": "node sandbox/launch.mjs",
    "sandbox:stop": "node sandbox/launch.mjs stop",
    "sandbox:status": "node sandbox/launch.mjs status",
    "test:sandbox": "node --test sandbox/*.test.mjs",
    "registry": "node registry/server.mjs",
    "test:registry": "node --test registry/server.test.mjs",
    "test:registry:core": "node scripts/e2e-registry.mjs",
    "test:registry:node": "node scripts/e2e-registry-node.mjs",
    "tokens": "pnpm --filter @hoi/tokens build",
    "core:wasm": "node scripts/build-wasm.mjs",
    "core:test:wasi": "node scripts/test-core-wasi.mjs",
    "dev:site": "pnpm --filter @hoi/site dev",
    "dev:web": "pnpm --filter @hoi/web dev",
    "dev:desktop": "pnpm --filter @hoi/desktop dev",
    "dev:setup": "pnpm --filter @hoi/setup dev",
    "build:site": "pnpm --filter @hoi/site build",
    "sbom": "node apps/site/scripts/sbom.mjs",
    "check:wiki": "node apps/site/scripts/wiki-check.mjs && node apps/site/scripts/sbom.mjs --check",
    "build:web": "pnpm --filter @hoi/web build",
    "build:all": "node scripts/build-all.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:setup": "pnpm --filter @hoi/setup build",
    "deploy:server": "node deploy/server/bundle/deploy.mjs --bundle dist/server/hoi-server-linux-x64",
    "build": "pnpm tokens && pnpm core:wasm && pnpm build:site && pnpm build:web && node scripts/assemble-static.mjs",
    "check": "pnpm -r --if-present check",
    "test": "node --test scripts/*.test.mjs registry/*.test.mjs relay/*.test.mjs && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.56.1",
    "axe-core": "4.14.0",
    "binaryen": "132.0.0",
    "playwright": "1.56.1"
  }
}
