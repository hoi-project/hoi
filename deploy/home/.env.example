# Copy to .env next to compose.yml, then start: docker compose -f deploy/home/compose.yml up -d --build

# What your phone and browser call this node.
HOI_NODE_NAME='home node'

# Optional. Gigabytes a day this node may relay for others; over it, it pauses until the next day.
HOI_DAILY_CAP_GB=5

# Optional. Run an image you built or pulled instead of building here.
# HOI_NODE_IMAGE=hoi-node:local
