# Copy to .env, then set the one required value before starting the carrier.

# Exact public IP:UDP-port browsers and phones reach this host at. IPv6 needs brackets,
# e.g. [2001:db8::10]:7844. Open UDP 7843, 7844, 7846 and 7847 on the host firewall.
HOI_RTC_ADVERTISE=

# Optional. Communities to carry at most (those waiting for their founder included).
HOI_CARRY_LIMIT=256

# Optional. Run a prebuilt image instead of building locally.
# HOI_CARRIER_IMAGE=registry.example.org/hoi-public-carrier:preview

HOI_NODE_NAME='public node'
