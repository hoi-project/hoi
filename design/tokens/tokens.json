{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "hoi.sh", "version": "0.1.0", "updated": "2026-10-22" },
  "color": {
    "light": {
      "bg":     { "value": "#FBFAF5", "role": "page ground (warm off-white)" },
      "card":   { "value": "#FFFFFF", "role": "framed surfaces" },
      "ink":    { "value": "#1A1A1A", "role": "text, outlines, primary buttons" },
      "mute":   { "value": "#6A6A63", "role": "secondary text" },
      "line":   { "value": "#D9D7CC", "role": "dotted dividers, idle borders" },
      "soft":   { "value": "#F0EEE4", "role": "hover fills, hidden-post ground" },
      "onink":  { "value": "#FFFFFF", "role": "text on ink" },
      "coral":  { "value": "#FF6B4A", "role": "upvote, compose, flood, danger-adjacent" },
      "cobalt": { "value": "#2F55E6", "role": "trusted, verified, links, downvote-adjacent" },
      "sun":    { "value": "#FFE16A", "role": "active tab, stickers, mod badge, switch knob" },
      "mint":   { "value": "#BFF0D0", "role": "community tag, relay on, success" },
      "sky":    { "value": "#CFE6FF", "role": "community tag, friend badge ground" },
      "lilac":  { "value": "#DCD2FF", "role": "community tag, your avatar" },
      "peach":  { "value": "#FFD2C2", "role": "community tag, removed/bounced" }
    },
    "dark": {
      "bg":     { "value": "#15151A" },
      "card":   { "value": "#1E1E24" },
      "ink":    { "value": "#F4F2EA" },
      "mute":   { "value": "#A3A39A" },
      "line":   { "value": "#34343B" },
      "soft":   { "value": "#26262D" },
      "onink":  { "value": "#15151A" },
      "cobalt": { "value": "#8AA0FF" },
      "_note":  "coral, sun, mint, sky, lilac, peach are unchanged in dark; text on them is always #1A1A1A"
    },
    "community_palette": ["mint", "sky", "lilac", "peach", "sun", "coral"],
    "semantic": {
      "trusted":  "cobalt",
      "yours":    "sun",
      "removed":  "peach",
      "hidden":   "soft",
      "relay_on": "mint"
    }
  },
  "font": {
    "display": { "family": "Gabarito", "fallback": "system-ui, sans-serif", "weights": [400, 500, 600, 700, 800, 900], "source": "Google Fonts" },
    "mono":    { "family": "Geist Mono", "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace", "weights": [400, 500], "source": "Google Fonts", "use": "key fingerprints, record ids, hashes only" }
  },
  "type": {
    "hero":    { "size": "clamp(44px, 8.6vw, 118px)", "weight": 900, "lineHeight": 0.93, "tracking": "-0.045em" },
    "h1":      { "size": "clamp(30px, 3.2vw, 40px)", "weight": 900, "lineHeight": 1.0, "tracking": "-0.035em" },
    "h2":      { "size": "clamp(34px, 5vw, 54px)",  "weight": 900, "lineHeight": 1.02, "tracking": "-0.035em" },
    "title":   { "size": "clamp(19px, 2vw, 25px)",  "weight": 800, "lineHeight": 1.15, "tracking": "-0.02em" },
    "lead":    { "size": "clamp(17px, 1.6vw, 20px)", "weight": 400, "lineHeight": 1.5 },
    "body":    { "size": "16px", "weight": 400, "lineHeight": 1.45 },
    "meta":    { "size": "14px", "weight": 500, "color": "mute" },
    "tag":     { "size": "13px", "weight": 700 },
    "mono":    { "size": "12px", "weight": 400 }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "14": "56px", "18": "72px" },
  "radius": { "tag": "999px", "pill": "999px", "card": "20px", "frame": "24px", "input": "14px", "poof": "14px" },
  "stroke": { "outline": "2px solid ink", "divider": "2px dotted line", "section": "2px solid ink", "offset_shadow": "3px 3px 0 ink (chips) / 6px 6px 0 ink (hero card)" },
  "motion": {
    "library": "animejs 4.x (IIFE build, global `anime`)",
    "ease": {
      "enter":  "outExpo",
      "pop":    "outBack(2)",
      "stamp":  "outElastic(1, .55)",
      "spring": "createSpring({ stiffness: 110..320, damping: 9..16 })",
      "ambient":"inOutSine"
    },
    "duration": { "micro": 300, "ui": 420, "enter": 520, "hero": 900 },
    "stagger":  { "rows": 45, "words": 55, "nodes": 40 },
    "reduced_motion": "respect prefers-reduced-motion: skip ambient loops and entrances; keep state changes instant"
  },
  "layout": {
    "max_width": "1120px (site) / 1240px (app)",
    "gutter": "max(16px, env(safe-area-inset-*))",
    "app_columns": "210px index + fluid main; stacks under 860px",
    "touch_target": "44px minimum"
  }
}
